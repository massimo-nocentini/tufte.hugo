{{- /*
  RSS feed (home, sections, taxonomies, terms): Hugo's embedded rss.xml,
  except that each item's description is the theme's processed summary
  (func/content.html with "summary" true, the one list pages show), not
  the raw .Summary. The raw one still holds the theme's phase-1 markup:
  placeholders of generated lists, empty figure-number tokens ("Figure :"),
  unresolved cross-references (the label key as link text) and hidden
  sidenote-end markers. Summaries resolve numbers and references against
  the full page; links are relative to the site, as on the list pages.
  Items are newest first by publication date; undated pages (book
  chapters, in each book's reading order) come last, without <pubDate>
  (see below).
  The language tag is the language's locale (func/lang.html).

  Authors: params.author.email, when set, is published, as in Hugo's
  embedded feed: RSS 2.0 wants an address in <managingEditor>,
  <webMaster> and an item's <author> ("EMAIL (NAME)"). An item credits its
  page's own authors (front matter `author`, tufte/authors.html): the site
  author's "EMAIL (NAME)" only when the page has no `author` of its own,
  else the names in <dc:creator> (Dublin Core, which takes a name without
  an address). Without an e-mail every item has <dc:creator>.
*/ -}}
{{- $authorEmail := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .email }}
      {{- $authorEmail = . }}
    {{- end }}
  {{- end }}
{{- end }}

{{- $authorName := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .name }}
      {{- $authorName = . }}
    {{- end }}
  {{- else }}
    {{- $authorName = . }}
  {{- end }}
{{- end }}

{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
  {{- $pages = $pctx.RegularPages }}
  {{- /* A book or a part of one: its chapters include those of its parts
         (sub-sections), as in the book's contents (tufte/book/chapters.html
         reads each part's RegularPagesRecursive). */}}
  {{- if and $.IsSection (partialCached "tufte/book/root.html" $ (or $.RelPermalink $.Path)) }}
    {{- $pages = $.RegularPagesRecursive }}
  {{- end }}
{{- else }}
  {{- $pages = $pctx.Pages }}
{{- end }}
{{- /* Pages without a URL (build.render = never) cannot be linked. */}}
{{- $linked := slice }}
{{- range $pages }}{{ if .Permalink }}{{ $linked = $linked | append . }}{{ end }}{{ end }}
{{- $pages = $linked }}
{{- /* Newest first by publication date, not in Hugo's default order
       (weight first): book chapters carry a weight and no date, so they
       would come first, dated year 0001, and push every post past the
       feed limit. Undated pages follow the dated ones, and their items
       have no <pubDate> (optional in RSS 2.0): the chapters of each book
       in its reading order (tufte/book/sequence.html: matter, weight,
       file name, parts kept together), book after book in the order of
       their first undated page, then the undated pages outside any book
       in Hugo's default order (weight, then title):
       tufte/undated-order.html, shared with tufte/archive-list.html. */}}
{{- $dated := slice }}{{ $undated := slice }}
{{- range $pages }}{{ if .PublishDate.IsZero }}{{ $undated = $undated | append . }}{{ else }}{{ $dated = $dated | append . }}{{ end }}{{ end }}
{{- with $dated }}{{ $dated = .ByPublishDate.Reverse }}{{ end }}
{{- range partial "tufte/undated-order.html" $undated }}{{ $dated = $dated | append . }}{{ end }}
{{- $pages = $dated }}
{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
  {{- $pages = $pages | first $limit }}
{{- end }}
{{- /* <lastBuildDate>: the latest non-zero Lastmod of the items, else the
       channel page's own (a dated book root whose chapters are all
       undated); none at all when every date is zero (never year 0001). */}}
{{- $built := "" }}
{{- range $pages }}
  {{- if not .Lastmod.IsZero }}
    {{- if or (not $built) (.Lastmod.After $built) }}{{ $built = .Lastmod }}{{ end }}
  {{- end }}
{{- end }}
{{- if not $built }}
  {{- if not .Lastmod.IsZero }}{{ $built = .Lastmod }}{{ else if not .Date.IsZero }}{{ $built = .Date }}{{ end }}
{{- end }}
{{- /* <copyright>: Hugo's top-level `copyright`, else the footer's
       params.copyright as plain text (its Markdown rendered and stripped,
       paragraphs joined by a space). */}}
{{- $copyright := site.Copyright }}
{{- if not $copyright }}
  {{- with site.Params.copyright }}
    {{- $copyright = printf "%v" . | markdownify | plainify | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace }}
  {{- end }}
{{- end }}
{{- $lang := partial "func/lang.html" site.Language }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    {{- /* The channel title is the plain title (tufte/plain-title.html), as in <title>. */}}
    {{- $chTitle := "" }}{{ $pt := partial "tufte/page-title.html" . }}{{ if ne $pt site.Title }}{{ with $pt }}{{ $chTitle = partial "tufte/plain-title.html" (dict "page" $ "title" .) }}{{ end }}{{ end }}
    {{- /* "Posts on Site", "Recent content in Posts on Site": i18n keys
           rssTitle, rssDescription and rssDescriptionSite (func/t.html);
           html/template escapes the result for XML. */}}
    {{- $fields := dict "Title" $chTitle "Site" site.Title }}
    {{- $descKey := "rssDescriptionSite" }}{{ if $chTitle }}{{ $descKey = "rssDescription" }}{{ end }}
    <title>{{ if $chTitle }}{{ partial "func/t.html" (dict "key" "rssTitle" "data" $fields) }}{{ else }}{{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ partial "func/t.html" (dict "key" $descKey "data" $fields) }}</description>
    <generator>Hugo</generator>
    <language>{{ $lang.locale }}</language>{{ with $authorEmail }}
    <managingEditor>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with $authorEmail }}
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with $copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ with $built }}
    <lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- $summary := partialCached "func/content.html" (dict "page" . "summary" true) (or .RelPermalink .Path) true }}
    {{- /* Hugo makes the feed's root-relative src= and href= absolute,
           not poster= (the video shortcode's poster image): done here,
           with the site's scheme and host (the path already holds the
           base path; with canonifyURLs, whose root-relative URLs lack it,
           tufte/postprocess.html has made such a poster= absolute). */}}
    {{- if strings.Contains (string $summary) ` poster="/` }}
      {{- $bu := urls.Parse site.BaseURL }}
      {{- if $bu.Host }}
        {{- $summary = replaceRE ` poster="/([^/"][^"]*)?"` (printf ` poster="%s://%s/$1"` $bu.Scheme $bu.Host) (string $summary) }}
      {{- end }}
    {{- end }}
    <item>
      {{- /* The title the page itself shows (tufte/page-title.html: an
             untitled archive page is "Archives"), as for the channel. */}}
      <title>{{ partial "tufte/plain-title.html" (dict "page" . "title" (partial "tufte/page-title.html" .)) }}</title>
      <link>{{ .Permalink }}</link>
      {{- if not .PublishDate.IsZero }}
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- end }}
      {{- if and $authorEmail (not .Params.author) }}
      <author>{{ $authorEmail }}{{ with $authorName }} ({{ . }}){{ end }}</author>
      {{- else }}{{ with (partial "tufte/authors.html" (dict "page" .)).plain }}
      <dc:creator>{{ . }}</dc:creator>
      {{- end }}{{ end }}
      <guid>{{ .Permalink }}</guid>
      {{- if strings.TrimSpace (string $summary) }}
      <description>{{ string $summary | transform.XMLEscape | safeHTML }}</description>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
